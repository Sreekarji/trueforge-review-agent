# Copy to .env and fill in. .env is gitignored — never commit it.

TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=

# Model FQN copied from Settings -> Models after adding the provider

TRUEFORGE_MODEL=bai/deepseek-v4-flash

# Names of connectors configured in the TrueForge UI (not secrets)

TRUEFORGE_GITHUB_CONNECTOR=github
TRUEFORGE_DEEPWIKI_CONNECTOR=deepwiki
TRUEFORGE_AGENT_NAME=pr-receipts-reviewer

# Default review target

REVIEW_REPO=Sreekarji/trueforge-review-agent
REVIEW_PR=1

# Safety switch — leave unset. Only set to 1 for unattended CI runs.

RECEIPTS_ALLOW_AUTO_APPROVE=
